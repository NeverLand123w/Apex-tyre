    {
      "path": "src/EditorialFooter.jsx",
      "absolutePath": "/home/hell/Desktop/apex-grip/src/EditorialFooter.jsx",
      "name": "EditorialFooter.jsx",
      "extension": ".jsx",
      "size": 3790,
      "created": "2026-10-18T10:21:56.671Z",
      "modified": "2026-10-18T10:50:46.704Z",
      "content": "// EditorialFooter.jsx\nimport { useRef } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { useGSAP } from \"@gsap/react\";\nimport { splitWords, scroll } from \"./fx\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nexport function EditorialFooter() {\n  const root = useRef(null), track = useRef(null), btn = useRef(null);\n\n  useGSAP(() => {\n    const words = splitWords(root.current.querySelector(\"[data-w]\"));\n    gsap.fromTo(\n      words,\n      { opacity: 0.12, y: 10 },\n      {\n        opacity: 1,\n        y: 0,\n        stagger: 0.1,\n        ease: \"power2.out\",\n        scrollTrigger: {\n          trigger: \".foot-st\",\n          start: \"top 85%\",\n          end: \"bottom 55%\",\n          scrub: true,\n        },\n      }\n    );\n\n    // Spec rows stagger reveal\n    gsap.from(\".foot-side dl div\", {\n      y: 18,\n      opacity: 0,\n      duration: 0.7,\n      stagger: 0.1,\n      ease: \"power3.out\",\n      scrollTrigger: {\n        trigger: \".foot-side\",\n        start: \"top 88%\",\n      },\n    });\n\n    // Marquee: drifts continuously and reacts smoothly to scroll velocity\n    let x = 0;\n    const setX = gsap.quickSetter(track.current, \"xPercent\");\n    const setSkew = gsap.quickSetter(track.current, \"skewX\", \"deg\");\n\n    const tick = () => {\n      x -= 0.035 + Math.abs(scroll.v) * 0.025;\n      if (x <= -50) x += 50;\n      setX(x);\n      setSkew(gsap.utils.clamp(-8, 8, scroll.v * 0.45));\n    };\n\n    const reduceMotion = matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n    if (!reduceMotion) gsap.ticker.add(tick);\n\n    // Magnetic button with inner text parallax\n    const buttonEl = btn.current;\n    const btnText = buttonEl.querySelector(\"span\");\n    const mx = gsap.quickTo(buttonEl, \"x\", { duration: 0.45, ease: \"power3\" });\n    const my = gsap.quickTo(buttonEl, \"y\", { duration: 0.45, ease: \"power3\" });\n    const tx = gsap.quickTo(btnText, \"x\", { duration: 0.35, ease: \"power3\" });\n    const ty = gsap.quickTo(btnText, \"y\", { duration: 0.35, ease: \"power3\" });\n\n    const move = (e) => {\n      const r = buttonEl.getBoundingClientRect();\n      const dx = e.clientX - r.left - r.width / 2;\n      const dy = e.clientY - r.top - r.height / 2;\n      mx(dx * 0.28);\n      my(dy * 0.28);\n      tx(dx * 0.12);\n      ty(dy * 0.12);\n    };\n    const leave = () => {\n      mx(0);\n      my(0);\n      tx(0);\n      ty(0);\n    };\n\n    buttonEl.addEventListener(\"mousemove\", move);\n    buttonEl.addEventListener(\"mouseleave\", leave);\n\n    return () => {\n      gsap.ticker.remove(tick);\n      buttonEl.removeEventListener(\"mousemove\", move);\n      buttonEl.removeEventListener(\"mouseleave\", leave);\n    };\n  }, { scope: root });\n\n  return (\n    <footer ref={root} className=\"foot\">\n      <div className=\"foot-top\">\n        <p className=\"foot-st disp\" data-w>\n          Grip is the only thing that ever touches the road.\n        </p>\n        <div className=\"foot-side\">\n          <dl>\n            <div><dt>Carcass</dt><dd>Aramid, three layers</dd></div>\n            <div><dt>Belts</dt><dd>High-tension dual steel</dd></div>\n            <div><dt>Compound</dt><dd>Silica carbon</dd></div>\n          </dl>\n          <a\n            ref={btn}\n            href=\"#dossier\"\n            onClick={(e) => e.preventDefault()}\n            className=\"btn\"\n          >\n            <span>Read the technical dossier</span>\n          </a>\n        </div>\n      </div>\n      <div className=\"marquee\" aria-hidden=\"true\">\n        <div ref={track} className=\"track disp\">\n          {[0, 1].map((n) => (\n            <div key={n}>\n              {[\"Wet grip\", \"Lateral grip\", \"Wet grip\", \"Lateral grip\"].map((t, i) => (\n                <span key={i}>{t}<i className=\"dot\" /></span>\n              ))}\n            </div>\n          ))}\n        </div>\n      </div>\n    </footer>\n  );\n}",
      "lines": 129,
      "isText": true
    },
    {
      "path": "src/frameMap.js",
      "absolutePath": "/home/hell/Desktop/apex-grip/src/frameMap.js",
      "name": "frameMap.js",
      "extension": ".js",
      "size": 1112,
      "created": "2026-10-18T10:10:03.033Z",
      "modified": "2026-10-18T10:10:13.872Z",
      "content": "export const SEGMENTS = [\n  { a: 1,   b: 45,  vh: 100 }, // Act I: Awakening\n  { a: 46,  b: 75,  vh: 102 }, // Act II: Deconstruction\n  { a: 75,  b: 75,  vh: 25  }, // HOLD: peak explosion (read time)\n  { a: 75,  b: 110, vh: 123 }, // Act II: Reassemble\n  { a: 111, b: 180, vh: 200 }, // Act III: Hydro-Dynamic\n  { a: 181, b: 240, vh: 200 }, // Act IV: Apex Heat\n  { a: 241, b: 275, vh: 70  }, // Act V: Camera goes overhead\n  { a: 275, b: 275, vh: 130 }, // HOLD: User picks spec here\n  { a: 276, b: 300, vh: 80  }, // Act VI: Tyre rolls away\n];\n\n// This calculates how tall the webpage should be based on the numbers above (1030)\nexport const TOTAL_VH = SEGMENTS.reduce((s, g) => s + g.vh, 0); \n// We add 100 for the height of the user's screen itself.\nexport const CONTAINER_HEIGHT = `${TOTAL_VH + 100}vh`; \n\n// This function translates how far the user scrolled into an exact Frame Number.\nexport function frameAt(progress) { \n  let v = progress * TOTAL_VH;\n  for (const g of SEGMENTS) {\n    if (v <= g.vh) return g.a + (g.b - g.a) * (v / g.vh);\n    v -= g.vh;\n  }\n  return SEGMENTS[SEGMENTS.length - 1].b;\n}",
      "lines": 26,
      "isText": true
    },
    {
      "path": "src/fx.js",
      "absolutePath": "/home/hell/Desktop/apex-grip/src/fx.js",
      "name": "fx.js",
      "extension": ".js",
      "size": 1454,
      "created": "2026-10-18T10:39:41.026Z",
      "modified": "2026-10-18T11:05:43.261Z",
      "content": "// fx.js\nexport const scroll = { v: 0 };\nexport const clamp = (v) => Math.min(1, Math.max(0, v));\n\n// Smooth cubic easing so scroll-scrubbed letters settle naturally instead of linearly\nconst easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);\nconst easeInCubic = (t) => t * t * t;\n\nconst split = (el, cls, parts) => {\n    if (!el) return [];\n    const text = el.dataset.raw || el.textContent;\n    el.dataset.raw = text;\n    el.setAttribute(\"aria-label\", text);\n    el.innerHTML = \"\";\n    return parts(text).map((p) => {\n        const s = document.createElement(\"span\");\n        s.className = cls;\n        s.setAttribute(\"aria-hidden\", \"true\");\n        s.innerHTML = cls === \"ch\" ? `<i>${p === \" \" ? \"\\u00A0\" : p}</i>` : p;\n        el.appendChild(s);\n        return s;\n    });\n};\n\nexport const splitChars = (el) => split(el, \"ch\", (t) => [...t]);\nexport const splitWords = (el) => split(el, \"w\", (t) => t.split(/\\s+/).filter(Boolean));\n\n// e: enter 0..1, x: exit 0..1. Characters roll up with cubic easing and subtle 3D tilt.\nexport function roll(chars, e, x = 0) {\n  const n = chars.length, k = 6;\n  chars.forEach((c, i) => {\n    const rawIn = clamp((e * (n + k) - i) / k);\n    const rawOut = clamp((x * (n + k) - i) / k);\n    const a = 1 - Math.pow(1 - rawIn, 3);\n    const b = rawOut * rawOut * rawOut;\n    const y = (1 - a) * 122 - b * 122;\n    const rot = (1 - a) * 7 - b * 5;\n    c.style.transform = `translate3d(0, ${y}%, 0) rotateZ(${rot}deg)`;\n  });\n}",
      "lines": 40,
      "isText": true
    },
    {
      "path": "src/index.css",
      "absolutePath": "/home/hell/Desktop/apex-grip/src/index.css",
      "name": "index.css",
      "extension": ".css",
      "size": 13463,
      "created": "2026-10-18T08:23:49.928Z",
      "modified": "2026-10-18T11:43:41.756Z",
      "content": "/* Replace or merge into index.css */\n@import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Hanken+Grotesk:wght@300;400;500&display=swap');\n\n@tailwind base;\n@tailwind components;\n@tailwind utilities;\n\n:root {\n  /* 60 / 30 / 10 */\n  --rubber: #090E0C;\n  /* 60%  canvas: carbon green-black */\n  --panel: #121A17;\n  /* 30%  structure: panels */\n  --bone: #DCE0D5;\n  /* 30%  structure: type, lines (cool fog) */\n  --ash: #84908A;\n  /* 30%  structure: secondary type */\n  --signal: #F4C20D;\n  /* 10%  accent: sidewall-paint yellow */\n  --v: #F4C20D;\n  --vel-skew: 0deg;\n}\n\nhtml,\nbody {\n  background: var(--rubber);\n  overscroll-behavior: none;\n  scrollbar-width: none;        /* Firefox */\n  -ms-overflow-style: none;  \n}\n\nhtml::-webkit-scrollbar,\nbody::-webkit-scrollbar {\n  display: none;                /* Chrome, Safari, new Edge */\n}\n\nbody {\n  color: var(--bone);\n  font-family: 'Hanken Grotesk', sans-serif;\n  overflow-x: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\nhtml.lenis,\nhtml.lenis body {\n  height: auto;\n}\n\n.lenis.lenis-smooth {\n  scroll-behavior: auto !important;\n}\n\n.lenis.lenis-stopped {\n  overflow: hidden;\n}\n\n::selection {\n  background: var(--signal);\n  color: var(--rubber);\n}\n\n:focus-visible {\n  outline: 2px solid var(--signal);\n  outline-offset: 3px;\n}\n\nbutton {\n  cursor: pointer;\n}\n\n.disp {\n  font-family: 'Big Shoulders Display', sans-serif;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n/* Preloader: tyre spools up, then its bore opens onto the site */\n.pre {\n  --r: -2px;\n  position: fixed;\n  inset: 0;\n  z-index: 100;\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  background: var(--rubber);\n  -webkit-mask-image: radial-gradient(circle at 50% 50%, transparent var(--r), #000 calc(var(--r) + 1.5px));\n  mask-image: radial-gradient(circle at 50% 50%, transparent var(--r), #000 calc(var(--r) + 1.5px));\n}\n\n.pre::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(38% 38% at 50% 50%, rgba(244, 194, 13, .07), transparent 72%);\n}\n\n.pre-edge {\n  --r: -2px;\n  position: fixed;\n  inset: 0;\n  z-index: 101;\n  pointer-events: none;\n  background: radial-gradient(circle at 50% 50%,\n      transparent calc(var(--r) - 1px),\n      var(--signal) calc(var(--r) - 1px),\n      var(--signal) calc(var(--r) + 2px),\n      transparent calc(var(--r) + 2px));\n}\n\n.pre-wheel {\n  position: relative;\n  width: min(64vmin, 560px);\n  aspect-ratio: 1;\n  height: auto;\n  overflow: visible;\n  will-change: transform;\n}\n\n.pre-ring {\n  fill: none;\n  stroke: var(--bone);\n  stroke-opacity: .35;\n  stroke-width: .6;\n}\n\n.pre-block {\n  fill: var(--bone);\n}\n\n.pre-block.lo {\n  fill-opacity: .4;\n}\n\n.pre-tick {\n  stroke: var(--ash);\n  stroke-opacity: .45;\n  stroke-width: 1;\n}\n\n.pre-tick.on {\n  stroke: var(--signal);\n  stroke-opacity: 1;\n}\n\n.pre-sw {\n  font: 500 8.2px 'Hanken Grotesk', sans-serif;\n  fill: var(--ash);\n}\n\n.pre-spoke {\n  fill: rgba(220, 224, 213, .05);\n  stroke: var(--bone);\n  stroke-opacity: .5;\n  stroke-width: .6;\n}\n\n.pre-bolt {\n  fill: var(--bone);\n  fill-opacity: .7;\n}\n\n.pre-dot {\n  fill: var(--signal);\n}\n\n.pre-n {\n  position: absolute;\n  left: 3vw;\n  bottom: 2.5vw;\n  font-size: clamp(6rem, 20vw, 20rem);\n  line-height: .8;\n  font-variant-numeric: tabular-nums;\n}\n\n.pre-w {\n  position: absolute;\n  right: 3vw;\n  bottom: 3vw;\n  font-size: 1.5rem;\n  color: var(--ash);\n  letter-spacing: .08em;\n}\n\n.pre-s {\n  position: absolute;\n  left: 3vw;\n  top: 3vw;\n  font-size: .9rem;\n  color: var(--bone);\n}\n\n.pre-meta {\n  position: absolute;\n  right: 3vw;\n  top: 3vw;\n  font-size: .8rem;\n  color: var(--ash);\n}\n\n/* Stage */\n.stage {\n  position: sticky;\n  top: 0;\n  width: 100vw;\n  height: 100vh;\n  height: 100dvh;\n  padding: 10px;\n  /* Outer gap like your desktop window manager */\n  box-sizing: border-box;\n  background: var(--rubber);\n  overflow: hidden;\n}\n\n.stage::before {\n  content: \"\";\n  position: absolute;\n  inset: 10px;\n  border-radius: 16px;\n  border: 1px solid rgba(220, 224, 213, 0.14);\n  /* Soft inner vignette so left/right edges blend smoothly into the bezel */\n  box-shadow:\n    inset 0 0 80px rgba(9, 14, 12, 0.85),\n    inset 0 1px 0 rgba(255, 255, 255, 0.08);\n  pointer-events: none;\n  z-index: 35;\n}\n\n.stage canvas {\n  position: absolute;\n  inset: 10px;\n  width: calc(100% - 20px);\n  height: calc(100% - 20px);\n  border-radius: 16px;\n  object-fit: cover;\n  mix-blend-mode: screen;\n  z-index: 10;\n}\n\n.glow {\n  position: absolute;\n  inset: 10px;\n  border-radius: 16px;\n  z-index: 5;\n  opacity: 0.12;\n  background: radial-gradient(60% 60% at 50% 52%, var(--v), transparent 72%);\n  transition: background 0.6s ease;\n}\n\n/* HUD */\n.hud {\n  position: absolute;\n  inset: 0;\n  z-index: 40;\n  pointer-events: none;\n}\n\n.bar {\n  position: absolute;\n  top: 10px;\n  left: 24px;\n  right: 24px;\n  width: auto;\n  height: 2px;\n  background: var(--v);\n  transform: scaleX(0);\n  transform-origin: left;\n  z-index: 45;\n}\n\n.mark {\n  position: absolute;\n  top: 2.2vw;\n  left: 3vw;\n  font-size: 1.6rem;\n  letter-spacing: .08em;\n}\n\n.cnt {\n  position: absolute;\n  top: 2.4vw;\n  right: 3vw;\n  font-size: .8rem;\n  color: var(--ash);\n  font-variant-numeric: tabular-nums;\n}\n\n.scrollhint {\n  position: absolute;\n  bottom: 2vw;\n  right: 3vw;\n  font-size: .8rem;\n  color: var(--ash);\n  display: flex;\n  gap: .8rem;\n}\n\n.pct {\n  color: var(--bone);\n  font-variant-numeric: tabular-nums;\n  min-width: 4ch;\n  text-align: right;\n}\n\n/* Rail */\n.rail {\n  position: absolute;\n  right: 1.5vw;\n  top: 50%;\n  transform: translateY(-50%);\n  z-index: 45;\n  display: flex;\n  flex-direction: column;\n  gap: .85rem;\n  align-items: flex-end;\n}\n\n.rail button {\n  background: none;\n  border: 0;\n  color: var(--ash);\n  font: inherit;\n  font-size: .75rem;\n  letter-spacing: .04em;\n  display: flex;\n  align-items: center;\n  gap: .65rem;\n  padding: .25rem 0;\n  transition: color .3s ease;\n}\n\n.rail button::after {\n  content: \"\";\n  width: 1.1rem;\n  height: 1px;\n  background: currentColor;\n  transition: width .45s cubic-bezier(.16, 1, .3, 1), background .35s ease;\n}\n\n.rail button span {\n  opacity: 0;\n  transform: translateX(6px);\n  transition: opacity .35s ease, transform .35s cubic-bezier(.16, 1, .3, 1);\n}\n\n.rail button:hover {\n  color: var(--bone);\n}\n\n.rail button:hover span,\n.rail button.on span {\n  opacity: 1;\n  transform: translateX(0);\n}\n\n.rail button.on {\n  color: var(--bone);\n}\n\n.rail button.on::after {\n  width: 2.6rem;\n  background: var(--v);\n}\n\n/* Chapters */\n/* Replace the Chapters section in index.css with this: */\n.chap {\n  position: absolute;\n  z-index: 20;\n  max-width: 92vw;\n  /* Prevents 34rem guillotine on wide display headings */\n  pointer-events: none;\n  visibility: hidden;\n}\n\n.ttl {\n  margin: 0;\n  font-family: 'Big Shoulders Display', sans-serif;\n  font-weight: 900;\n  text-transform: uppercase;\n  font-size: clamp(4.2rem, 12.5vw, 14rem);\n  line-height: .88;\n  transform: skewY(var(--vel-skew, 0deg));\n  transition: transform .15s ease-out;\n  will-change: transform;\n}\n\n.mask {\n  display: block;\n  overflow: hidden;\n  /* Extra vertical & right padding prevents top/bottom/right glyph clipping */\n  padding: .08em .08em .06em .02em;\n  margin: -.05em 0;\n  white-space: nowrap;\n}\n\n/* Keep right-aligned chapters (Act 2 & Act 4) flush to the right edge */\n.p2 .mask,\n.p4 .mask {\n  margin-left: auto;\n}\n\n.ch {\n  display: inline-block;\n  will-change: transform;\n  transform-origin: bottom left;\n}\n\n.ch i {\n  display: inline-block;\n  font-style: normal;\n  will-change: transform;\n}\n\n.bd {\n  margin: 1.6rem 0 0;\n  font-weight: 300;\n  font-size: clamp(1rem, 1.25vw, 1.2rem);\n  line-height: 1.55;\n  max-width: 32ch;\n}\n\n.w {\n  display: inline-block;\n  margin-right: .28em;\n  will-change: transform, opacity;\n}\n\n.st {\n  margin-top: 2rem;\n  display: flex;\n  align-items: baseline;\n  flex-wrap: wrap;\n  gap: .3rem .7rem;\n  will-change: transform, opacity;\n}\n\n.st b {\n  font-size: clamp(3.5rem, 7vw, 7rem);\n  line-height: 1;\n  color: var(--v);\n  font-variant-numeric: tabular-nums;\n  transition: color .5s ease;\n}\n\n.st span {\n  font-size: 1.1rem;\n}\n\n.st small {\n  flex-basis: 100%;\n  color: var(--ash);\n  font-size: .85rem;\n}\n\n.p1 {\n  inset: 0;\n  max-width: none;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  padding: 12vh 4vw 6vh 3.5vw;\n}\n\n/* Refined scale so the tyre sidewall & cyan mesh stay visible in the center */\n.p1 .ttl {\n  font-size: clamp(3.2rem, 8.2vw, 9.5rem);\n  line-height: 0.86;\n  letter-spacing: -0.01em;\n}\n\n.p1 .bd {\n  position: absolute;\n  top: 14vh;\n  right: 7vw;\n  margin: 0;\n  max-width: 26ch;\n  text-align: left;\n  border-left: 1px solid rgba(244, 194, 13, 0.55);\n  padding-left: 1rem;\n  color: rgba(220, 224, 213, 0.85);\n}\n\n.p2 {\n  right: 5vw;\n  top: 14vh;\n  text-align: right;\n}\n\n.p3 {\n  left: 3vw;\n  top: 14vh;\n}\n\n.p4 {\n  right: 5vw;\n  bottom: 9vh;\n  text-align: right;\n}\n\n.p5 {\n  left: 3vw;\n  bottom: 8vh;\n}\n\n.p6 {\n  left: 3vw;\n  top: 50%;\n  transform: translateY(-50%);\n}\n\n.p2 .bd,\n.p4 .bd {\n  margin-left: auto;\n}\n\n.p2 .st,\n.p4 .st {\n  justify-content: flex-end;\n}\n\n/* Variant panel */\n.spec {\n  position: absolute;\n  z-index: 30;\n  right: 6vw;\n  top: 50%;\n  transform: translate3d(24px, -50%, 0);\n  width: min(24rem, 40vw);\n  padding: 1.6rem;\n  background: rgba(18, 26, 23, .74);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(220, 224, 213, .14);\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity .65s cubic-bezier(.16, 1, .3, 1), transform .65s cubic-bezier(.16, 1, .3, 1);\n}\n\n[data-panel=\"1\"] .spec {\n  opacity: 1;\n  transform: translate3d(0, -50%, 0);\n  pointer-events: auto;\n}\n\n.spec-tabs {\n  display: flex;\n  gap: 1.2rem;\n}\n\n.spec-tabs button {\n  background: none;\n  border: 0;\n  padding: 0;\n  color: var(--ash);\n  font-size: 2.4rem;\n  line-height: 1;\n  transition: color .3s ease, transform .3s ease;\n}\n\n.spec-tabs button:hover {\n  color: var(--bone);\n}\n\n.spec-tabs button[aria-pressed=\"true\"] {\n  color: var(--v);\n}\n\n.spec-meta {\n  margin: .6rem 0 0;\n  font-size: .8rem;\n  color: var(--ash);\n}\n\n.spec-radar {\n  width: 100%;\n  margin: 1rem 0;\n  color: var(--bone);\n  overflow: visible;\n}\n\n.spec-list {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: .45rem 1.5rem;\n  margin: 0;\n  font-size: .85rem;\n}\n\n.spec-list div {\n  display: flex;\n  justify-content: space-between;\n  border-bottom: 1px solid rgba(220, 224, 213, .12);\n  padding-bottom: .3rem;\n}\n\n.spec-list dt {\n  color: var(--ash);\n}\n\n.spec-list dd {\n  margin: 0;\n  font-variant-numeric: tabular-nums;\n  font-weight: 500;\n}\n\n/* Footer */\n.foot {\n  position: relative;\n  z-index: 20;\n  background: var(--bone);\n  color: var(--rubber);\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  padding-top: 14vh;\n  overflow: hidden;\n}\n\n.foot-top {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4rem;\n  justify-content: space-between;\n  padding: 0 3vw;\n}\n\n.foot-st {\n  margin: 0;\n  max-width: 14ch;\n  font-size: clamp(3.5rem, 11vw, 12rem);\n  line-height: .86;\n}\n\n.foot-side {\n  align-self: flex-end;\n  display: flex;\n  flex-direction: column;\n  gap: 2.5rem;\n  min-width: min(20rem, 90vw);\n}\n\n.foot-side dl {\n  margin: 0;\n}\n\n.foot-side dl div {\n  display: flex;\n  justify-content: space-between;\n  gap: 2rem;\n  padding: .7rem 0;\n  border-bottom: 1px solid rgba(9, 14, 12, .2);\n  font-size: .9rem;\n}\n\n.foot-side dt {\n  opacity: .55;\n}\n\n.foot-side dd {\n  margin: 0;\n  font-weight: 500;\n}\n\n.btn {\n  align-self: flex-start;\n  display: inline-block;\n  padding: 1.1rem 2rem;\n  border: 1px solid var(--rubber);\n  color: var(--rubber);\n  text-decoration: none;\n  font-weight: 500;\n  position: relative;\n  overflow: hidden;\n  transition: color .4s cubic-bezier(.16, 1, .3, 1);\n  will-change: transform;\n}\n\n.btn span {\n  position: relative;\n  z-index: 1;\n  display: inline-block;\n  will-change: transform;\n}\n\n.btn::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: var(--signal);\n  transform: translateY(101%);\n  transition: transform .5s cubic-bezier(.16, 1, .3, 1);\n}\n\n.btn:hover {\n  color: var(--rubber);\n}\n\n.btn:hover::before {\n  transform: translateY(0);\n}\n\n.marquee {\n  overflow: hidden;\n  margin-top: 8vh;\n  padding-bottom: 2vh;\n}\n\n.track {\n  display: flex;\n  width: max-content;\n  font-size: clamp(7rem, 20vw, 22rem);\n  line-height: .9;\n  will-change: transform;\n}\n\n.track>div {\n  display: flex;\n  align-items: center;\n}\n\n.track span {\n  display: flex;\n  align-items: center;\n  white-space: nowrap;\n  padding-right: 3vw;\n}\n\n.dot {\n  width: 1.6vw;\n  height: 1.6vw;\n  border-radius: 50%;\n  background: var(--rubber);\n  margin-left: 3vw;\n  display: inline-block;\n}\n\n@media (max-width: 767px) {\n  .rail {\n    display: none;\n  }\n\n  .ttl {\n    font-size: clamp(3.4rem, 19vw, 6rem);\n  }\n\n  .p1 .ttl {\n    font-size: clamp(3rem, 15vw, 5.5rem);\n  }\n\n  .p1 .bd {\n    position: static;\n    margin-top: 1.2rem;\n    border-left: 0;\n    padding-left: 0;\n  }\n\n  .p2,\n  .p3 {\n    top: 12vh;\n  }\n\n  .p4,\n  .p5 {\n    bottom: 6vh;\n  }\n\n  .p5 {\n    transition: opacity .4s;\n  }\n\n  [data-panel=\"1\"] .p5 {\n    opacity: 0;\n  }\n\n  .spec,\n  [data-panel=\"1\"] .spec {\n    top: auto;\n    bottom: 3vh;\n    left: 3vw;\n    right: 3vw;\n    width: auto;\n    transform: translate3d(0, 0, 0);\n    padding: 1.1rem;\n  }\n\n  .spec-radar {\n    max-height: 28vh;\n  }\n\n  .spec-list {\n    display: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n\n  .btn::before,\n  .spec,\n  .rail button::after,\n  .ttl {\n    transition: none;\n    transform: none !important;\n  }\n}",
